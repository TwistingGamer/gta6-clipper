# Which streamers may be clipped lives in sources.yaml (copy sources.example.yaml).
# Nothing is recorded, clipped or posted for a streamer that isn't approved there.

# --- Twitch (live status, chat, viewer clips) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
GTA_ONLY=true                 # only watch/record while the stream category is GTA
# Record live streams with Streamlink. Also needs allow_recording: true on that streamer.
CAPTURE_STREAMS=false
SEGMENT_SECONDS=300

# --- Clipping ---
POLL_SECONDS=60
CLIP_SECONDS=36
MAX_CLIPS_PER_SEGMENT=2
MIN_SCORE=0.15                # signal threshold for a candidate window
MIN_AI_SCORE=6                # 0-10; AI judge must rate a clip at least this high
CAPTIONS=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
HOOK_SECONDS=4
AD_LABEL="Paid partnership #ad"

# --- AI judge (optional; without a key, every candidate is kept with plain titles) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- Review and posting ---
AUTO_APPROVE=false            # false = you approve each clip (python -m clipbot approve ID)
AUTO_POST=false               # post approved clips automatically
POST_PLATFORMS=youtube,tiktok,instagram
POSTS_PER_DAY=3               # per platform, spaced evenly

YOUTUBE_PRIVACY=private       # private | unlisted | public

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_PRIVACY=SELF_ONLY      # PUBLIC_TO_EVERYONE only works after TikTok audits your app

IG_USER_ID=
IG_ACCESS_TOKEN=              # long-lived token, expires after ~60 days
IG_GRAPH_HOST=graph.facebook.com
IG_GRAPH_VERSION=v21.0
