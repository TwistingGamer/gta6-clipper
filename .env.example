# Set to true ONLY for streams you own or have explicit permission to record and repost.
AUTHORIZED_SOURCE=false
# Comma-separated approved channel names. E.g. creator_one,creator_two
STREAMERS=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Requires streamlink CLI. Disable unless you have authorization from creators/platform.
CAPTURE_STREAMS=false
# Queue uploads by default. Set true only after YouTube OAuth and policy checks.
AUTO_UPLOAD_YOUTUBE=false
YOUTUBE_PRIVACY=private
POLL_SECONDS=60
SEGMENT_SECONDS=300
CLIP_SECONDS=36
MAX_CLIPS_PER_SEGMENT=2
MIN_SCORE=0.25
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
UPLOADS_PER_DAY=3
MAX_RECORDINGS_GB=10
