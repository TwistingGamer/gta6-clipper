# Campaigns (what may be clipped, where, and the rules) live in campaigns.yaml
# (copy campaigns.example.yaml). Nothing is touched for a campaign that isn't active there.

# --- Where things live (all paths can be on D:) ---
# Leave blank to keep everything (recordings, clips, temp files, AI models) inside the bot's folder.
STORAGE_DIR=
# Full paths to tools if they aren't on PATH (Windows example below). FFPROBE is found next to FFMPEG.
FFMPEG_PATH=                  # e.g. D:\tools\ffmpeg\bin\ffmpeg.exe
STREAMLINK_PATH=              # normally blank: Streamlink is installed inside the bot's .venv

# --- Twitch (live status, chat, viewer clips) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Record live streams with Streamlink. Also needs allow_recording: true on that campaign.
CAPTURE_STREAMS=true
# moments = watch chat live, keep only the last BUFFER_MINUTES of video, and save just the
#           moments chat reacts to (small, constant disk use). Twitch only; Kick/YouTube use full.
# full    = record whole streams in SEGMENT_SECONDS chunks (lots of disk).
CAPTURE_MODE=moments
BUFFER_MINUTES=8
MOMENT_PRE_SECONDS=60         # video kept before the chat spike (chat reacts after the action)
MOMENT_POST_SECONDS=20
SPIKE_FACTOR=3                # chat must run this many times above its normal rate
SPIKE_MIN_RATE=2              # ...and at least this many messages per second
SPIKE_COOLDOWN=60
KEEP_RECORDINGS_HOURS=24      # saved moments are deleted after this
SEGMENT_SECONDS=300

# --- Finding GTA streams (campaign gta-any) ---
DISCOVER_EVERY_MINUTES=5
DISCOVER_KEEP_HOURS=6

# --- Clipping ---
POLL_SECONDS=60
CLIP_SECONDS=36               # length of the window that's scored
CONTEXT_SECONDS=25            # clip starts this long before the moment, so viewers see the setup
AFTER_SECONDS=10              # ...and ends this long after it (payoff + reaction)
MAX_CLIPS_PER_SEGMENT=2
MAX_CLIPS_PER_HOUR=6          # for long VODs
FETCH_EVERY_MINUTES=30
MIN_SCORE=0.15                # signal threshold for a candidate window
MIN_AI_SCORE=6                # 0-10; AI judge must rate a clip at least this high
CAPTIONS=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
HOOK_SECONDS=4
# Vertical framing: auto = facecam on top + gameplay below when a webcam is found, else gameplay fills
# the screen. Also: split, fill, fit (whole frame on a blurred background).
FRAME_MODE=auto
# FACECAM=0,0.55,0.25,0.35     # force the webcam box (x,y,w,h as fractions of the frame) if auto misses it
AD_LABEL="Paid partnership #ad"

# --- AI judge (optional; without a key, every candidate is kept with plain titles and no hook text) ---
# With a key, each clip also gets a hook line on screen that explains the setup (better context).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- Review and posting ---
AUTO_APPROVE=false            # false = you approve each clip (python -m clipbot approve ID)
AUTO_POST=true                # stage/post approved clips on schedule
# manual = clip + caption copied to output/ready/<platform>/ and you get a ping to post it from your phone
# api    = upload through the official API (only once your API app is approved)
POST_MODE_TIKTOK=manual
POST_MODE_INSTAGRAM=manual
POST_MODE_YOUTUBE=manual
POST_MODE_X=manual            # X has no API uploader here (API posting is paid)
NOTIFY_WEBHOOK_URL=           # Discord channel webhook for phone pings
TIKTOK_USERNAME=
POST_PLATFORMS=tiktok,instagram,youtube,x
ACCOUNTS_STARTED=2026-11-18   # warm-up: 1 post/day/platform in week 1, +1 each week
POSTS_PER_DAY=3               # ceiling after warm-up

YOUTUBE_PRIVACY=private       # private | unlisted | public

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_PRIVACY=SELF_ONLY      # PUBLIC_TO_EVERYONE only works after TikTok audits your app

IG_USER_ID=
IG_ACCESS_TOKEN=              # long-lived token, expires after ~60 days
IG_GRAPH_HOST=graph.facebook.com
IG_GRAPH_VERSION=v21.0
